# =============================================================================
# oz-agent-worker environment variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ------------------------------------------------------------------------------
# Required - Warp Platform
# ------------------------------------------------------------------------------

# Warp service account API key (obtain from Warp team settings)
WARP_API_KEY=wk-

# Unique identifier for this worker instance (must not start with "warp")
WORKER_ID=my-worker

# ------------------------------------------------------------------------------
# Cloudflare Tunnel (for Codespace access)
# ------------------------------------------------------------------------------
# Get token from: https://one.dash.cloudflare.com/ → Networks → Tunnels
# Create tunnel, copy the token (starts with eyJ...)
# This makes your Codespace accessible via oz-warp.aknibir.systems

# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiYWJjMTIzLi4uLi4

# ------------------------------------------------------------------------------
# GHCR Authentication (for pulling the worker image)
# ------------------------------------------------------------------------------
# Only needed if using Docker to run the worker from GHCR
# Get token at: https://github.com/settings/tokens (scope: read:packages)

# GITHUB_TOKEN=ghp-your-github-token
# GITHUB_USERNAME=aks-tech-lab
# CONTAINER_REGISTRY=ghcr.io
# IMAGE_NAME=ghcr.io/aks-tech-lab/oz-warp.aknibir.systems:latest

# ------------------------------------------------------------------------------
# Docker connectivity (optional – defaults to local socket)
# ------------------------------------------------------------------------------

# Override the Docker daemon address
# Examples:
#   unix:///var/run/docker.sock   (default on Linux)
#   tcp://remote-host:2376        (remote daemon over TCP)
# DOCKER_HOST=unix:///var/run/docker.sock

# Pin a specific Docker API version
# DOCKER_API_VERSION=1.41

# Path to TLS certificates when connecting to a remote daemon
# DOCKER_CERT_PATH=/path/to/certs

# Enable TLS verification for remote daemon connections
# DOCKER_TLS_VERIFY=1

# Use a named Docker context (from ~/.docker/config.json)
# DOCKER_CONTEXT=my-remote-context

# ------------------------------------------------------------------------------
# Optional worker behaviour
# ------------------------------------------------------------------------------

# Log level: debug | info | warn | error  (default: info)
# LOG_LEVEL=info
